{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 1000,
	"windowMinHeight": 740,
	"windowMaxWidth": 1200,
	"windowMaxHeight": 900,
	"width": 1000,
	"height": 740,
	"rightMargin": 16,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onUnload",
		"onTimer",
		"onClick"
	],
	"windowTitle": "SerialPort demo",
	"destination": "detailScreen",
	"method": "method.4dm",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"hdrTitle": {
					"type": "text",
					"text": "SerialPort — a CLI-backed 4D component, driven by an owner worker",
					"top": 12,
					"left": 16,
					"width": 760,
					"height": 24,
					"fontSize": 18,
					"fontWeight": "bold"
				},
				"subTitle": {
					"type": "text",
					"text": "A PTY simulator stands in for the missing serial hardware. Nothing here needs a real device.",
					"top": 40,
					"left": 16,
					"width": 760,
					"height": 18,
					"fontSize": 12
				},
				"statusText": {
					"type": "input",
					"dataSource": "Form.statusText",
